# Database (local dev — Docker compose default)
DATABASE_URL=postgresql://qris:qris@localhost:5435/qris_wallet
# API
PORT=3000
LOG_LEVEL=info
# Chain RPC (defaults: sepolia.base.org / mainnet.base.org)
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# BASE_RPC_URL=https://mainnet.base.org
# Browser PWA origin(s), comma-separated
# ALLOWED_ORIGINS=http://localhost:3100
# Founder CLI only (never commit): passphrase for `pnpm wallet`
# WALLET_PASSPHRASE=
# v1 caps per PRD §9.3 (enforced in code from M2; values here are the intended defaults)
# MAX_PAYMENT_IDR=500000
# MAX_DAILY_IDR=2000000
# M4 first-party settlement — all local-only, never on shared infra.
# ENGINE_OFFRAMP=manual      # mock (default) | manual
# ENGINE_PAYMENT=manual      # mock (default) | manual
# ENGINE_CHAIN=real          # mock (default) | real (viem + Base)
# ENGINE_NETWORK=base-sepolia # default testnet; "base" = real money
# MANUAL_IDR_PER_USDC=15900  # required with ENGINE_OFFRAMP=manual (your own exchange screen)
# FUNDING_PRIVATE_KEY=0x...  # required with ENGINE_CHAIN=real (founder key, local only)
# FUNDING_DESTINATION=0x...  # where the funding leg sends (your own address)
# OPERATOR_SECRET=...        # HMAC secret for /internal/* + pnpm operator
# API_URL=http://localhost:3000  # operator CLI target
# REQUIRED_CONFIRMATIONS=12
# CONFIRM_TIMEOUT_SEC=300
