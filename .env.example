# Database (local dev — Docker compose default)
DATABASE_URL=postgresql://qris:qris@localhost:5435/qris_wallet
# API
PORT=3000
LOG_LEVEL=info
# Chain RPC (defaults: sepolia.base.org / mainnet.base.org)
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# BASE_RPC_URL=https://mainnet.base.org
# Browser PWA origin(s), comma-separated
# ALLOWED_ORIGINS=http://localhost:3100
# Founder CLI only (never commit): passphrase for `pnpm wallet`
# WALLET_PASSPHRASE=
# v1 caps per PRD §9.3 (enforced in code from M2; values here are the intended defaults)
# MAX_PAYMENT_IDR=500000
# MAX_DAILY_IDR=2000000
