{
  "name": "qris-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crypto everyday payment wallet — USDC to QRIS (v1, first-party assisted settlement per PRD §6.2)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "wallet": "tsx scripts/wallet.ts",
    "operator": "tsx scripts/operator.ts",
    "reconcile": "tsx scripts/reconcile.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "viem": "^2.56.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
